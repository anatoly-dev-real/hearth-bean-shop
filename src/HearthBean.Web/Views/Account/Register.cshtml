@model RegisterViewModel
@{ ViewData["Title"] = T["Register"]; }
<section class="auth-page"><div class="auth-aside"><p class="eyebrow">HEARTH & BEAN</p><h1>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Место за вашим столом." : "A place at our table.")</h1><p>@T["HeroCopy"]</p><img src="~/images/cake.jpg" alt="A fresh cake from the bakery" /></div><form asp-action="Register" method="post" class="form-panel auth-form"><p class="eyebrow">@T["Register"]</p><h2>@T["CreateAccount"]</h2><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="FullName">@T["FullName"]</label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="field-error"></span><label asp-for="Email">@T["Email"]</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password">@T["Password"]</label><input asp-for="Password" autocomplete="new-password" /><span asp-validation-for="Password" class="field-error"></span><label asp-for="ConfirmPassword">@T["ConfirmPassword"]</label><input asp-for="ConfirmPassword" autocomplete="new-password" /><span asp-validation-for="ConfirmPassword" class="field-error"></span><button class="button button-dark button-wide" type="submit">@T["CreateAccount"]</button><p class="form-footnote">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Минимум 8 символов. Пароли хранятся через ASP.NET Identity." : "At least 8 characters. Passwords are handled by ASP.NET Identity.")</p></form></section>