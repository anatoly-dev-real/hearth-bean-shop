@model LoginViewModel
@{ ViewData["Title"] = T["SignIn"]; }
<section class="auth-page login-page"><div class="auth-aside"><p class="eyebrow">HEARTH & BEAN</p><h1>@T["SignInTitle"]</h1><p>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Мы уже поставили кофе." : "We have the coffee on.")</p><img src="~/images/coffee.jpg" alt="Fresh coffee ready at the bakery" /></div><form asp-action="Login" method="post" class="form-panel auth-form"><p class="eyebrow">ACCOUNT</p><h2>@T["SignInTitle"]</h2><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Email">@T["Email"]</label><input asp-for="Email" autocomplete="email" /><span asp-validation-for="Email" class="field-error"></span><label asp-for="Password">@T["Password"]</label><input asp-for="Password" autocomplete="current-password" /><span asp-validation-for="Password" class="field-error"></span><button class="button button-dark button-wide" type="submit">@T["SignIn"]</button><p class="form-footnote">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Нет аккаунта?" : "New around here?") <a asp-action="Register">@T["Register"]</a></p></form></section>