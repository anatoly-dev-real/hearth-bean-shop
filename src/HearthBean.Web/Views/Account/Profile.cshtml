@model ProfileViewModel
@{ ViewData["Title"] = T["NavProfile"]; }
<section class="simple-page narrow-page"><p class="eyebrow">HEARTH & BEAN · ACCOUNT</p><h1>@T["NavProfile"]</h1><form asp-action="Profile" method="post" class="form-panel"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="FullName">@T["FullName"]</label><input asp-for="FullName" autocomplete="name" /><span asp-validation-for="FullName" class="field-error"></span><label asp-for="Phone">@T["Phone"]</label><input asp-for="Phone" autocomplete="tel" /><span asp-validation-for="Phone" class="field-error"></span><label asp-for="Address">@T["Address"]</label><input asp-for="Address" autocomplete="street-address" /><span asp-validation-for="Address" class="field-error"></span><button class="button button-dark" type="submit">@T["Save"]</button></form><a class="text-link below-link" asp-controller="Orders" asp-action="Index">@T["OrderHistory"] <span aria-hidden="true">↗</span></a></section>