@model IReadOnlyList<Order>
@{ ViewData["Title"] = T["OrderHistory"]; }
<section class="simple-page"><p class="eyebrow">HEARTH & BEAN · ACCOUNT</p><h1>@T["OrderHistory"]</h1>
    @if (Model.Count == 0){<div class="empty-state"><span class="empty-mark">h&b</span><h2>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Заказов пока нет." : "No orders just yet.")</h2><a class="button button-dark" asp-controller="Menu" asp-action="Index">@T["ExploreMenu"]</a></div>}
    else{<div class="table-wrap"><table class="data-table"><thead><tr><th>@T["OrderNumber"]</th><th>@T["Date"]</th><th>@T["Status"]</th><th>@T["Total"]</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td><a class="text-link" asp-action="Details" asp-route-id="@order.Id">#@order.Id</a></td><td>@order.OrderDate.ToLocalTime().ToString("d")</td><td><span class="status-chip">@order.Status</span></td><td>@order.TotalAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td><td>@if(order.Status == OrderStatuses.Pending){<form asp-action="Cancel" asp-route-id="@order.Id" method="post"><button type="submit" class="text-button remove-link">@T["CancelOrder"]</button></form>}</td></tr>}</tbody></table></div>}
</section>