@model Order
@{ ViewData["Title"] = $"{T["OrderNumber"]} #{Model.Id}"; }
<section class="simple-page narrow-page"><p class="eyebrow">@T["OrderHistory"]</p><h1>@T["OrderNumber"] #@Model.Id</h1><div class="order-facts"><span>@T["Date"]</span><strong>@Model.OrderDate.ToLocalTime().ToString("f")</strong><span>@T["Status"]</span><strong>@Model.Status</strong><span>@T["DeliveryMethod"]</span><strong>@(Model.DeliveryMethod == "Delivery" ? T["Delivery"] : T["Pickup"])</strong>@if(Model.DeliveryMethod == "Delivery"){<span>@T["Address"]</span><strong>@Model.DeliveryAddress</strong>}</div><div class="order-lines">@foreach(var item in Model.Items){<div class="checkout-line"><span>@item.Quantity × @CatalogText.Name(item.Product)</span><strong>@((item.UnitPrice * item.Quantity).ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US")))</strong></div>}</div><div class="summary-row"><span>@T["Total"]</span><strong>@Model.TotalAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong></div><a class="text-link below-link" asp-action="Index">← @T["OrderHistory"]</a></section>