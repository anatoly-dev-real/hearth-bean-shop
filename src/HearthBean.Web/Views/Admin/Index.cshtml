@model AdminDashboardViewModel
@{ ViewData["Title"] = T["AdminTitle"]; }
<section class="admin-page"><div class="admin-heading"><div><p class="eyebrow">HEARTH & BEAN · ADMIN</p><h1>@T["AdminTitle"]</h1></div><nav class="admin-nav"><a asp-action="Products">@T["Products"]</a><a asp-action="Categories">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Категории" : "Categories")</a><a asp-action="Orders">@T["Orders"]</a><a asp-action="Customers">@T["Customers"]</a><a asp-action="Reports">@T["Reports"]</a></nav></div>
    <div class="stat-grid"><article class="stat-item"><span>@T["Products"]</span><strong>@Model.ProductCount</strong></article><article class="stat-item"><span>@T["Orders"]</span><strong>@Model.OrderCount</strong></article><article class="stat-item"><span>@T["Customers"]</span><strong>@Model.CustomerCount</strong></article><article class="stat-item"><span>@T["Total"]</span><strong>@Model.PendingRevenue.ToString("C0", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong></article></div>
    <div class="admin-section-heading"><h2>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Последние заказы" : "Recent orders")</h2><a class="text-link" asp-action="Orders">@T["ViewAll"] ↗</a></div><div class="table-wrap"><table class="data-table"><thead><tr><th>@T["OrderNumber"]</th><th>@T["Customers"]</th><th>@T["Date"]</th><th>@T["Status"]</th><th>@T["Total"]</th></tr></thead><tbody>@foreach(var order in Model.RecentOrders){<tr><td>#@order.Id</td><td>@order.User.FullName</td><td>@order.OrderDate.ToLocalTime().ToString("d")</td><td><span class="status-chip">@order.Status</span></td><td>@order.TotalAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td></tr>}</tbody></table></div>
</section>