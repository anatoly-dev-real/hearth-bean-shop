@model IReadOnlyList<ApplicationUser>
@{ ViewData["Title"] = T["Customers"]; }
<section class="admin-page"><div class="admin-heading"><div><p class="eyebrow">ADMIN · PEOPLE</p><h1>@T["Customers"]</h1></div></div><partial name="_AdminNav" /><div class="table-wrap"><table class="data-table"><thead><tr><th>@T["FullName"]</th><th>@T["Email"]</th><th>@T["Phone"]</th><th>@T["Address"]</th></tr></thead><tbody>@foreach(var customer in Model){<tr><td>@customer.FullName</td><td>@customer.Email</td><td>@customer.PhoneNumber</td><td>@customer.Address</td></tr>}</tbody></table></div></section>