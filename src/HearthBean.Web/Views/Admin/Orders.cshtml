@model IReadOnlyList<Order>
@{ ViewData["Title"] = T["Orders"]; }
<section class="admin-page"><div class="admin-heading"><div><p class="eyebrow">ADMIN · FULFILMENT</p><h1>@T["Orders"]</h1></div></div><partial name="_AdminNav" /><form class="admin-search" method="get"><label class="sr-only" for="status-filter">@T["Status"]</label><select id="status-filter" name="status"><option value="">@T["AllCategories"]</option>@foreach(var status in OrderStatuses.All){<option value="@status" selected="@(ViewData["StatusFilter"]?.ToString() == status)">@status</option>}</select><button class="button button-outline" type="submit">@T["ApplyFilters"]</button></form><div class="table-wrap"><table class="data-table"><thead><tr><th>@T["OrderNumber"]</th><th>@T["Customers"]</th><th>@T["Date"]</th><th>@T["Total"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>@foreach(var order in Model){<tr><td>#@order.Id</td><td>@order.User.FullName<small class="table-subtitle">@order.User.Email</small></td><td>@order.OrderDate.ToLocalTime().ToString("g")</td><td>@order.TotalAmount.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td><td><span class="status-chip">@order.Status</span></td><td><form asp-action="SetOrderStatus" asp-route-id="@order.Id" method="post" class="status-form"><select name="status" aria-label="Set order status">@foreach(var status in OrderStatuses.All){<option value="@status" selected="@(order.Status == status)">@status</option>}</select><button class="text-button" type="submit">@T["Save"]</button></form></td></tr>}</tbody></table></div></section>