@model ProductEditViewModel
@{ ViewData["Title"] = Model.Id == 0 ? (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Новый товар" : "New product") : T["Products"]; }
<section class="admin-page narrow-page"><p class="eyebrow">ADMIN · CATALOG</p><h1>@ViewData["Title"]</h1><partial name="_AdminNav" /><form asp-action="SaveProduct" method="post" class="form-panel admin-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name">@T["Products"]</label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span><label asp-for="Slug">Slug</label><input asp-for="Slug" /><span asp-validation-for="Slug" class="field-error"></span><label asp-for="Description">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Описание (английский)" : "Description")</label><textarea asp-for="Description" rows="4"></textarea><span asp-validation-for="Description" class="field-error"></span><div class="form-row"><div><label asp-for="Price">@T["Price"] ($)</label><input asp-for="Price" type="number" step="0.01" min="0" /></div><div><label asp-for="StockQuantity">@T["StockLabel"]</label><input asp-for="StockQuantity" type="number" min="0" /></div></div><label asp-for="CategoryId">@T["Category"]</label><select asp-for="CategoryId"><option value="">—</option>@foreach(var category in Model.Categories){<option value="@category.Id">@CatalogText.CategoryName(category)</option>}</select><span asp-validation-for="CategoryId" class="field-error"></span><label asp-for="ImageFileName">Image file</label><select asp-for="ImageFileName"><option>bread.jpg</option><option>pastry.jpg</option><option>cake.jpg</option><option>coffee.jpg</option><option>seasonal.jpg</option></select><label class="choice-row"><input asp-for="IsVegan" /><span>@T["Vegan"]</span></label><button class="button button-dark" type="submit">@T["Save"]</button></form></section>