@model CategoryEditViewModel
@{ ViewData["Title"] = Model.Id == 0 ? (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Новая категория" : "New category") : (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Изменить категорию" : "Edit category"); }
<section class="admin-page narrow-page"><p class="eyebrow">ADMIN · CATALOG</p><h1>@ViewData["Title"]</h1><partial name="_AdminNav" /><form asp-action="SaveCategory" method="post" class="form-panel admin-form"><input asp-for="Id" type="hidden" /><div asp-validation-summary="ModelOnly" class="validation-summary"></div><label asp-for="Name">@T["Category"]</label><input asp-for="Name" /><span asp-validation-for="Name" class="field-error"></span><label asp-for="Slug">Slug</label><input asp-for="Slug" /><span asp-validation-for="Slug" class="field-error"></span><label asp-for="SortOrder">Sort order</label><input asp-for="SortOrder" type="number" min="0" max="1000" /><span asp-validation-for="SortOrder" class="field-error"></span><button class="button button-dark" type="submit">@T["Save"]</button></form></section>