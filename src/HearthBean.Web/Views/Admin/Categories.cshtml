@model IReadOnlyList<Category>
@{ ViewData["Title"] = T["Category"]; }
<section class="admin-page"><div class="admin-heading"><div><p class="eyebrow">ADMIN · CATALOG</p><h1>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Категории" : "Categories")</h1></div><a class="button button-dark" asp-action="NewCategory">+ @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Новая категория" : "New category")</a></div><partial name="_AdminNav" /><div class="table-wrap"><table class="data-table"><thead><tr><th>@T["Category"]</th><th>Slug</th><th>Sort</th><th>@T["Status"]</th><th></th></tr></thead><tbody>@foreach(var category in Model){<tr><td>@CatalogText.CategoryName(category)</td><td>@category.Slug</td><td>@category.SortOrder</td><td>@(category.IsAvailable ? "Visible" : "Hidden")</td><td class="table-actions"><a class="text-link" asp-action="EditCategory" asp-route-id="@category.Id">@T["Save"]</a><form asp-action="ToggleCategory" asp-route-id="@category.Id" method="post"><button class="text-button" type="submit">@(category.IsAvailable ? (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Скрыть" : "Hide") : (System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Показать" : "Show"))</button></form></td></tr>}</tbody></table></div></section>