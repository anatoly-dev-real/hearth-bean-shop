@model IReadOnlyList<Product>
@{ ViewData["Title"] = T["Products"]; }
<section class="admin-page"><div class="admin-heading"><div><p class="eyebrow">ADMIN · CATALOG</p><h1>@T["Products"]</h1></div><a class="button button-dark" asp-action="NewProduct">+ @(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Новый товар" : "New product")</a></div><partial name="_AdminNav" /><form class="admin-search" method="get"><input name="search" value="@ViewData["Search"]" placeholder="@T["Search"]" /><button class="button button-outline" type="submit">@T["ApplyFilters"]</button></form><div class="table-wrap"><table class="data-table"><thead><tr><th>@T["Products"]</th><th>@T["Category"]</th><th>@T["Price"]</th><th>@T["StockLabel"]</th><th>@T["Status"]</th><th></th></tr></thead><tbody>@foreach(var product in Model){<tr><td><strong>@product.Name</strong><small class="table-subtitle">/@product.Slug</small></td><td>@CatalogText.CategoryName(product.Category)</td><td>@product.Price.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td><td>@product.StockQuantity</td><td>@(product.IsAvailable ? "Visible" : "Hidden")</td><td class="table-actions"><a class="text-link" asp-action="EditProduct" asp-route-id="@product.Id">@T["Save"]</a>@if(product.IsAvailable){<form asp-action="HideProduct" asp-route-id="@product.Id" method="post"><button class="text-button remove-link" type="submit">@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Скрыть" : "Hide")</button></form>}</td></tr>}</tbody></table></div></section>