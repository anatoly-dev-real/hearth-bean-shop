@model ReportsViewModel
@{ ViewData["Title"] = T["Reports"]; }
<section class="admin-page"><div class="admin-heading"><div><p class="eyebrow">ADMIN · BUSINESS INTELLIGENCE</p><h1>@T["Reports"]</h1></div></div><partial name="_AdminNav" /><div class="report-grid"><section class="report-section"><h2>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Выручка по месяцам" : "Monthly revenue")</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>Month</th><th>Orders</th><th>@T["Total"]</th></tr></thead><tbody>@foreach(var row in Model.Revenue){<tr><td>@row.Year-@row.Month.ToString("00")</td><td>@row.Orders</td><td>@row.Revenue.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td></tr>}</tbody></table></div></section><section class="report-section"><h2>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Самые продаваемые товары" : "Top products")</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>@T["Products"]</th><th>Qty</th><th>@T["Total"]</th></tr></thead><tbody>@foreach(var row in Model.TopProducts){<tr><td>@row.Name</td><td>@row.Quantity</td><td>@row.Revenue.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</td></tr>}</tbody></table></div></section><section class="report-section"><h2>@(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName == "ru" ? "Мало на складе" : "Low stock")</h2><div class="table-wrap"><table class="data-table"><thead><tr><th>@T["Products"]</th><th>@T["Category"]</th><th>Qty</th></tr></thead><tbody>@foreach(var product in Model.LowStockProducts){<tr><td>@CatalogText.Name(product)</td><td>@CatalogText.CategoryName(product.Category)</td><td>@product.StockQuantity</td></tr>}</tbody></table></div></section></div></section>