@model CheckoutPageViewModel
@{ ViewData["Title"] = T["Checkout"]; }
<section class="simple-page checkout-page"><p class="eyebrow">HEARTH & BEAN · CHECKOUT</p><h1>@T["OrderDetails"]</h1>
    <div class="checkout-layout"><form asp-action="Index" method="post" class="form-panel checkout-form"><div asp-validation-summary="ModelOnly" class="validation-summary"></div><fieldset><legend>@T["DeliveryMethod"]</legend><label class="choice-row"><input asp-for="Checkout.DeliveryMethod" type="radio" value="Pickup" /><span>@T["Pickup"]</span></label><label class="choice-row"><input asp-for="Checkout.DeliveryMethod" type="radio" value="Delivery" /><span>@T["Delivery"]</span></label><span asp-validation-for="Checkout.DeliveryMethod" class="field-error"></span></fieldset><label asp-for="Checkout.Phone">@T["Phone"]</label><input asp-for="Checkout.Phone" autocomplete="tel" /><span asp-validation-for="Checkout.Phone" class="field-error"></span><label asp-for="Checkout.DeliveryAddress">@T["Address"]</label><input asp-for="Checkout.DeliveryAddress" autocomplete="street-address" /><span asp-validation-for="Checkout.DeliveryAddress" class="field-error"></span><label asp-for="Checkout.Note">@T["Note"]</label><textarea asp-for="Checkout.Note" rows="3"></textarea><button class="button button-dark button-wide" type="submit">@T["PlaceOrder"] <span aria-hidden="true">→</span></button><p class="form-footnote">@T["NoPayment"]</p></form>
    <aside class="checkout-summary"><h2>@T["YourBag"]</h2>@foreach (var line in Model.Cart.Lines){<div class="checkout-line"><span>@line.Quantity × @line.Name</span><strong>@line.LineTotal.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong></div>}<div class="summary-row"><span>@T["Total"]</span><strong>@Model.Cart.Total.ToString("C", System.Globalization.CultureInfo.GetCultureInfo("en-US"))</strong></div></aside></div>
</section>